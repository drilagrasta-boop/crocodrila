---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import sharp from 'sharp';
import path from 'node:path';

export async function getStaticPaths() {
  const entrevistas = (await getCollection('entrevistas')).filter((e) => !e.data.rascunho);
  return entrevistas.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const iniciais = entry.data.convidado.split(/\s+/).slice(0, 2).map((p) => p[0]).join('').toUpperCase();
// SVG não é aceito como og:image pelos apps (WhatsApp, X) — nesses casos fica a imagem padrão do site
const ogFoto = entry.data.foto && !entry.data.foto.endsWith('.svg') ? entry.data.foto : undefined;
// Lê a dimensão real da foto de OG no build (ajuda WhatsApp/Facebook a exibir a imagem grande)
let ogW: number | undefined, ogH: number | undefined;
if (ogFoto) {
  try {
    const meta = await sharp(path.join(process.cwd(), 'public', ogFoto)).metadata();
    ogW = meta.width; ogH = meta.height;
  } catch { /* sem dimensões: o app cai no fallback */ }
}
---
<Base title={`${entry.data.convidado} · Entrevista`} description={entry.data.resumo} image={ogFoto} imageWidth={ogW} imageHeight={ogH}>
  <article class="ent">
    <header class="wrap ent-head rise">
      <a href="/entrevistas" class="back mono">← todas as entrevistas</a>
      <span class="label eyebrow">O Outro Lado da Tela · {fmt.format(entry.data.data)}</span>
      <h1 class="ent-titulo">{entry.data.titulo}</h1>

      <div class="ent-cartao">
        <span class="ent-foto-col">
          <span class="ent-foto" aria-hidden="true">
            {entry.data.foto ? <img src={entry.data.foto_avatar ?? entry.data.foto} alt={entry.data.convidado} /> : <span>{iniciais}</span>}
          </span>
          {entry.data.foto_legenda && <span class="ent-fotocap mono">{entry.data.foto_legenda}</span>}
        </span>
        <div>
          <p class="ent-nome">{entry.data.convidado}</p>
          <p class="muted ent-papel">{entry.data.papel}</p>
        </div>
      </div>

      <p class="ent-resumo measure">{entry.data.resumo}</p>
      <hr class="rule" />
    </header>

    <div class="wrap ent-body">
      <div class="prose entrevista-prose">
        <Content />
      </div>
    </div>

    {entry.data.linkedin && (
      <div class="wrap ent-linkedin-wrap">
        <p class="ent-linkedin">
          <a href={entry.data.linkedin} target="_blank" rel="noopener" class="ent-linkedin-link">
            <svg class="ent-linkedin-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>
            </svg>
            {entry.data.convidado} no LinkedIn
          </a>
        </p>
      </div>
    )}

    <aside class="wrap ent-cta-wrap">
      <div class="ent-cta">
        <div>
          <span class="label eyebrow">Gostou da conversa?</span>
          <p class="ent-cta-text">Uma captura de IA por semana, direto na sua caixa. Sem rastreador, sem ruído.</p>
        </div>
        <a href="/assinar" class="btn btn--jacare">Inscreva-se →</a>
      </div>
    </aside>

    <footer class="wrap ent-foot">
      <hr class="rule" />
      <p class="muted">Tem um nome pra sugerir pra próxima conversa? Responda a edição no seu leitor ou escreva pra <a href="mailto:drilagrasta@gmail.com">drilagrasta@gmail.com</a>.</p>
    </footer>
  </article>
</Base>

<style>
  .ent-head { padding-top: clamp(2rem, 5vw, 3.5rem); }
  .back { display: inline-block; color: var(--ink-faint); text-decoration: none; font-size: 0.78rem; margin-bottom: 1.4rem; }
  .back:hover { color: var(--jacare); }
  .ent-titulo { margin-top: 0.8rem; }
  .ent-cartao { display: flex; align-items: center; gap: 1rem; margin-top: 1.6rem; }
  .ent-foto-col { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; flex: none; }
  .ent-fotocap { font-size: 0.56rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-deep); }
  .ent-foto { width: 64px; height: 64px; border-radius: 50%; overflow: hidden; background: linear-gradient(150deg, var(--jacare), var(--jacare-deep)); display: grid; place-items: center; color: var(--paper); font-family: var(--display); font-size: 1.3rem; font-weight: 600; flex: none; border: 1px solid var(--line-strong); }
  .ent-foto img { width: 100%; height: 100%; object-fit: cover; }
  .ent-nome { font-family: var(--display); font-size: 1.3rem; font-weight: 600; }
  .ent-papel { font-size: 0.9rem; margin-top: 0.1rem; }
  .ent-resumo { margin-top: 1.4rem; font-size: clamp(1.15rem, 1rem + 0.7vw, 1.4rem); font-style: italic; color: var(--ink-soft); }
  .ent-head .rule { margin-top: 2rem; }
  .ent-body { margin-top: 2.4rem; }

  .ent-cta-wrap { margin-top: 3.2rem; }
  .ent-cta { display: flex; align-items: center; justify-content: space-between; gap: 1.4rem; flex-wrap: wrap; padding: clamp(1.4rem, 4vw, 2rem) clamp(1.5rem, 4vw, 2.2rem); border: 1.5px solid var(--jacare); border-radius: var(--radius); background: #fffdf6; }
  .ent-cta-text { margin-top: 0.4rem; color: var(--ink-soft); max-width: 46ch; }
  .ent-cta .btn { white-space: nowrap; flex: none; }
  @media (max-width: 520px) { .ent-cta { flex-direction: column; align-items: flex-start; } }

  .ent-foot { margin-top: 3rem; }
  .ent-linkedin-wrap { margin-top: 2.8rem; }
  .ent-linkedin { margin: 0; }
  .ent-linkedin-link { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--jacare-deep); text-decoration: none; font-size: 0.92rem; font-weight: 500; }
  .ent-linkedin-link:hover { color: var(--jacare); text-decoration: underline; }
  .ent-linkedin-icon { flex: none; }

  /* destaca o entrevistador (negrito no início do parágrafo de pergunta) */
  .entrevista-prose :global(strong:first-child) { color: var(--jacare-deep); }

  /* fotos no corpo: legenda menor e apagada, para não se confundir com a fala */
  .entrevista-prose :global(figure.foto) { margin: 2.4em auto 2em; text-align: center; }
  .entrevista-prose :global(figure.foto img) { display: block; margin: 0 auto 0.7rem; }
  .entrevista-prose :global(figure.foto figcaption) {
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--ink-faint);
    max-width: 46ch;
    margin: 0 auto;
  }
  .entrevista-prose :global(figure.foto figcaption a) { color: var(--gold-deep); }
</style>
