---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const fmt = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });

const ensaios = (await getCollection('ensaios'))
  .filter((e) => !e.data.rascunho)
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime());

const destaque = ensaios[0];
const resto = ensaios.slice(1);
---
<Base title="Ensaios" description="Texto autoral sobre inteligência artificial, da casa e de convidados: argumento, experiência de uso, crítica, caso testado de perto." image="/og/site.png" imageWidth={800} imageHeight={800}>
  <section class="wrap head rise">
    <span class="label eyebrow">Textos autorais</span>
    <h1>Ensaios</h1>
    <p class="measure lead">A edição semanal traz a notícia, e a toca da Crocodrila traz a ferramenta com o passo a passo. Esta aba é para o que não cabe em nenhuma das duas: o argumento, a experiência de uso, a crítica, o caso testado de perto. Escrevem os editores da casa e os convidados que aceitarem o convite, cada um assinando o que pensa. Sem periodicidade, sem tamanho fixo e sem obrigação de concordar com a gente.</p>
    <p class="measure convite muted">Quer publicar aqui? Escreva para <a href="mailto:drilagrasta@gmail.com">drilagrasta@gmail.com</a> com o tema, ou com o texto pronto.</p>
  </section>

  {destaque && (
    <section class="wrap">
      <a href={`/ensaios/${destaque.id}`} class="feat">
        <span class="label">{fmt.format(destaque.data.data)}</span>
        <h2 class="feat-titulo">{destaque.data.titulo}</h2>
        {destaque.data.subtitulo && <p class="feat-sub">{destaque.data.subtitulo}</p>}
        <p class="feat-resumo">{destaque.data.resumo}</p>
        <p class="feat-autor mono">{destaque.data.autor}{destaque.data.papel && ` · ${destaque.data.papel}`}</p>
        <span class="feat-go mono">ler o ensaio →</span>
      </a>
    </section>
  )}

  {resto.length > 0 && (
    <section class="wrap arquivo">
      <div class="sec-head"><h2>Anteriores</h2></div>
      <ul class="en-list">
        {resto.map((e) => (
          <li>
            <a href={`/ensaios/${e.id}`} class="en-row">
              <span class="en-info">
                <span class="en-autor mono">{e.data.autor}{e.data.papel && ` · ${e.data.papel}`}</span>
                <span class="en-titulo">{e.data.titulo}</span>
                <span class="en-resumo muted">{e.data.resumo}</span>
                {e.data.tags.length > 0 && (
                  <span class="en-tags">
                    {e.data.tags.slice(0, 4).map((t) => <span class="tag mono">{t}</span>)}
                  </span>
                )}
              </span>
              <time class="en-data mono" datetime={e.data.data.toISOString()}>{fmt.format(e.data.data)}</time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {ensaios.length === 0 && (
    <section class="wrap vazio">
      <p class="muted">O primeiro ensaio está em edição. Enquanto isso, dá uma olhada na <a class="tlink" href="/crocodrila">toca da Crocodrila</a>.</p>
    </section>
  )}
</Base>

<style>
  .head { padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .lead { margin-top: 1rem; font-size: 1.2rem; color: var(--ink-soft); }
  .convite { margin-top: 1.1rem; font-size: 0.95rem; }

  .feat { display: block; margin-top: 2.4rem; text-decoration: none; color: inherit; border: 1.5px solid var(--ink); border-left: 4px solid var(--gold); border-radius: var(--radius); background: #fffdf6; padding: clamp(1.6rem, 4vw, 2.6rem); box-shadow: var(--shadow-doc); transition: transform .2s ease, box-shadow .2s ease; }
  .feat:hover { transform: translateY(-3px); box-shadow: 0 1px 0 var(--ink), 0 26px 50px -30px rgba(27,26,22,.6); }
  .feat-titulo { margin-top: 0.35rem; font-size: clamp(1.7rem, 1.3rem + 1.8vw, 2.6rem); }
  .feat-sub { margin-top: 0.5rem; font-size: 1.1rem; font-style: italic; color: var(--ink-soft); max-width: 56ch; }
  .feat-resumo { margin-top: 0.9rem; font-size: 1.08rem; color: var(--ink-soft); max-width: 60ch; }
  .feat-autor { margin-top: 1rem; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); }
  .feat-go { display: inline-block; margin-top: 1.2rem; color: var(--jacare-deep); font-size: 0.85rem; }
  .feat:hover .feat-go { text-decoration: underline; }

  .arquivo { margin-top: clamp(3rem, 7vw, 5rem); }
  .sec-head { margin-bottom: 1.4rem; }
  .en-list { list-style: none; padding: 0; border-top: 1px solid var(--line-strong); }
  .en-list li { border-bottom: 1px solid var(--line); }
  .en-row { display: grid; grid-template-columns: 1fr auto; gap: clamp(0.8rem, 3vw, 2rem); align-items: baseline; padding: 1.2rem 0.4rem; text-decoration: none; color: inherit; transition: background .15s ease, padding .15s ease; }
  .en-row:hover { background: var(--paper-deep); padding-inline: 1rem; }
  .en-info { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .en-autor { font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold-deep); }
  .en-titulo { font-family: var(--display); font-size: 1.25rem; }
  .en-resumo { font-size: 0.95rem; max-width: 62ch; }
  .en-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.2rem; }
  .en-data { font-size: 0.72rem; color: var(--ink-faint); white-space: nowrap; }
  @media (max-width: 600px) { .en-row { grid-template-columns: 1fr; } .en-data { display: none; } }

  .vazio { margin-top: 2.6rem; }
</style>
