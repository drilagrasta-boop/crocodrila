---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { ARTES_HOBBY } from '../../lib/og/artes.mjs';

export async function getStaticPaths() {
  const hobbies = (await getCollection('hobbies')).filter((h) => !h.data.rascunho);
  return hobbies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={`${entry.data.titulo} · Habemos Hobby`} description={entry.data.resumo} image={`/og/hobbies/${entry.id}.png`} imageWidth={1200} imageHeight={630}>
  <article class="hb">
    <header class="wrap hb-head rise">
      <a href="/hobbies" class="back mono">← Habemos Hobby</a>
      <div class="hb-topo">
        <div class="hb-topo-texto">
          <div class="hb-meta">
            {entry.data.categoria && <span class="hb-cat mono">{entry.data.categoria}</span>}
            <span class="dot">·</span>
            <span class="mono">{fmt.format(entry.data.data)}</span>
          </div>
          <h1>{entry.data.titulo}</h1>
          <p class="hb-resumo measure">{entry.data.resumo}</p>
        </div>
        {entry.data.arte && <div class="hb-arte" set:html={ARTES_HOBBY[entry.data.arte]} />}
      </div>

      {entry.data.materiais.length > 0 && (
        <aside class="materiais">
          <span class="label">O que basta para começar</span>
          <ul>
            {entry.data.materiais.map((m) => <li>{m}</li>)}
          </ul>
        </aside>
      )}
      <hr class="rule" />
    </header>

    <div class="wrap hb-body">
      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="wrap hb-foot">
      <hr class="rule" />
      <p class="muted">Fez o convite do mês? Mostra pra gente no grupo — ou não mostra pra ninguém, que também é o ponto.</p>
    </footer>
  </article>
</Base>

<style>
  .hb-head { padding-top: clamp(2rem, 5vw, 3.5rem); }
  .hb-topo { display: flex; gap: 1.6rem; align-items: flex-start; justify-content: space-between; }
  .hb-topo-texto { min-width: 0; }
  .hb-arte { flex: none; width: 130px; }
  .hb-arte :global(svg) { width: 100%; height: auto; }
  @media (max-width: 640px) { .hb-arte { display: none; } }
  .back { display: inline-block; color: var(--ink-faint); text-decoration: none; font-size: 0.78rem; margin-bottom: 1.4rem; }
  .back:hover { color: var(--gold-deep); }
  .hb-meta { display: flex; align-items: center; gap: 0.6rem; font-size: 0.78rem; }
  .hb-cat { text-transform: uppercase; letter-spacing: 0.12em; color: var(--gold-deep); }
  .dot { color: var(--line-strong); }
  h1 { margin-top: 0.9rem; }
  .hb-resumo { margin-top: 1rem; font-size: clamp(1.15rem, 1rem + 0.7vw, 1.4rem); color: var(--ink-soft); font-style: italic; }

  .materiais { margin-top: 1.8rem; padding: 1.3rem 1.5rem; background: #fffdf6; border: 1px solid var(--line); border-left: 3px solid var(--gold); border-radius: var(--radius); max-width: var(--measure); }
  .materiais ul { margin-top: 0.6rem; padding-left: 1.1em; display: flex; flex-direction: column; gap: 0.3rem; }
  .materiais li::marker { color: var(--gold-deep); }
  .hb-head .rule { margin-top: 2.2rem; }
  .hb-body { margin-top: 2.4rem; }
  .hb-foot { margin-top: 3rem; }
</style>
