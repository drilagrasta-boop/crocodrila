---
import Base from '../layouts/Base.astro';
import Crocodrila from '../components/Crocodrila.astro';

// O endereço do feed, usado no botão de copiar e no "Adicionar ao Feedly".
const FEED = 'https://crocodrila.netlify.app/rss.xml';
const feedlyUrl = `https://feedly.com/i/subscription/feed/${encodeURIComponent(FEED)}`;
const buttondownAction = 'https://buttondown.com/api/emails/embed-subscribe/crocodrila';
---
<Base title="Assinar" description="Como receber cada edição do Condenados à Atualização em IA — por e-mail ou por RSS, sem rastreador.">
  <section class="wrap assinar rise">
    <span class="label eyebrow">Assinar</span>
    <h1>Receba cada edição.</h1>
    <p class="abre measure">
      Duas formas de não perder a captura semanal. Escolha a que combina com você.
      Nenhuma das duas tem rastreador, algoritmo ou intermediário decidindo o que você vê.
    </p>

    <div class="opts">
      <!-- E-MAIL -->
      <article class="opt opt--email">
        <div class="opt-head">
          <span class="opt-kicker mono">A mais simples</span>
          <h2>Por e-mail</h2>
        </div>
        <p>
          A edição cai na sua caixa quando sai. Deixe seu e-mail, confirme no link que
          chega em seguida, e pronto.
        </p>
        <form id="bd-form" action={buttondownAction} method="post" class="bd-form">
          <label for="bd-email" class="sr-only">Seu e-mail</label>
          <input type="email" name="email" id="bd-email" placeholder="seu@email.com" autocomplete="email" required class="bd-input" />
          <button type="submit" class="btn btn--jacare">Assinar</button>
        </form>
        <p id="bd-msg" class="bd-msg" hidden></p>
        <p class="opt-fine muted">
          Sem custo, sem rastreador. Para sair, é um clique no rodapé de qualquer edição.
        </p>
      </article>

      <!-- RSS -->
      <article class="opt opt--rss">
        <div class="opt-head">
          <span class="opt-kicker mono">Para quem já usa</span>
          <h2>Por RSS</h2>
        </div>
        <p>
          RSS é um jeito antigo e ótimo de seguir sites sem dar seu e-mail a ninguém:
          um leitor de feeds junta tudo que você acompanha num lugar só, na ordem em que
          sai. Sem login, sem anúncio, sem ninguém reordenando por você.
        </p>

        <ol class="rss-steps">
          <li>
            Instale um leitor grátis. No celular ou no navegador, o
            <a class="tlink" href="https://feedly.com" target="_blank" rel="noopener">Feedly</a> e o
            <a class="tlink" href="https://www.inoreader.com" target="_blank" rel="noopener">Inoreader</a>
            resolvem; no computador, o
            <a class="tlink" href="https://netnewswire.com" target="_blank" rel="noopener">NetNewsWire</a> (grátis e sem conta).
          </li>
          <li>
            Cole o endereço do nosso feed nele:
            <div class="feed-row">
              <code id="feed-url">{FEED}</code>
              <button type="button" id="copy-feed" class="btn-copy mono">copiar</button>
            </div>
          </li>
          <li>Pronto. Cada edição nova aparece sozinha no seu leitor.</li>
        </ol>

        <div class="rss-cta">
          <a href={feedlyUrl} class="btn btn--ghost" target="_blank" rel="noopener">Adicionar ao Feedly num clique</a>
          <a href="/rss.xml" class="tlink mono">ver o feed cru</a>
        </div>
      </article>
    </div>

    <div class="assinar-foot">
      <Crocodrila size={40} />
      <p class="muted">
        Prefere só folhear quando der vontade? O <a class="tlink" href="/edicoes">arquivo</a>
        guarda todas as edições, numeradas como autos.
      </p>
    </div>
  </section>
</Base>

<script>
  // Inscrição por e-mail (Buttondown). Envia em segundo plano para o usuário não sair do site;
  // o duplo opt-in do Buttondown manda o e-mail de confirmação.
  const form = document.getElementById('bd-form') as HTMLFormElement | null;
  const msg = document.getElementById('bd-msg');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const body = new FormData(form);
    fetch(form.action, { method: 'POST', body, mode: 'no-cors' }).finally(() => {
      form.hidden = true;
      if (msg) {
        msg.hidden = false;
        msg.textContent = 'Quase lá — confira seu e-mail e clique no link de confirmação.';
      }
    });
  });

  const btn = document.getElementById('copy-feed');
  const url = document.getElementById('feed-url')?.textContent ?? '';
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(url);
      const old = btn.textContent;
      btn.textContent = 'copiado ✓';
      setTimeout(() => (btn.textContent = old), 1600);
    } catch {
      // Se o navegador bloquear a área de transferência, seleciona o texto como plano B.
      const range = document.createRange();
      const node = document.getElementById('feed-url');
      if (node) { range.selectNodeContents(node); getSelection()?.removeAllRanges(); getSelection()?.addRange(range); }
    }
  });
</script>

<style>
  .assinar { padding-top: clamp(2.5rem, 6vw, 4.5rem); padding-bottom: 2rem; }
  .assinar h1 { margin-top: 0.8rem; }
  .abre { margin-top: 1.2rem; font-size: clamp(1.1rem, 1rem + 0.6vw, 1.35rem); color: var(--ink-soft); }

  .opts { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin-top: 2.6rem; }
  @media (max-width: 720px) { .opts { grid-template-columns: 1fr; } }

  .opt { border: 1.5px solid var(--line-strong); border-radius: var(--radius); padding: clamp(1.5rem, 4vw, 2.2rem); background: #fffdf6; display: flex; flex-direction: column; }
  .opt--email { border-color: var(--jacare); border-left-width: 3px; }
  .opt-head { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 0.8rem; }
  .opt-kicker { font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold-deep); }
  .opt h2 { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); }
  .opt p { color: var(--ink-soft); }
  .opt .btn { margin-top: 1.2rem; align-self: flex-start; }
  .opt-fine { margin-top: 1rem; font-size: 0.85rem; }

  .bd-form { display: flex; gap: 0.5rem; margin-top: 1.2rem; flex-wrap: wrap; }
  .bd-input { flex: 1 1 12rem; min-width: 0; padding: 0.6em 0.8em; border: 1.5px solid var(--line-strong); border-radius: 8px; background: var(--paper); font: inherit; font-size: 1rem; color: var(--ink); }
  .bd-input:focus { outline: none; border-color: var(--jacare); box-shadow: 0 0 0 3px color-mix(in srgb, var(--jacare) 22%, transparent); }
  .bd-form .btn { margin-top: 0; }
  .bd-msg { margin-top: 1.1rem; color: var(--jacare-deep); font-weight: 500; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  .rss-steps { margin-top: 1.1rem; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.7rem; color: var(--ink-soft); }
  .rss-steps li { padding-left: 0.3rem; }
  .feed-row { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; flex-wrap: wrap; }
  .feed-row code { font-family: var(--mono); font-size: 0.8rem; background: var(--paper-deep); border: 1px solid var(--line-strong); border-radius: 6px; padding: 0.4em 0.6em; color: var(--ink); word-break: break-all; }
  .btn-copy { cursor: pointer; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.45em 0.8em; border: 1px solid var(--jacare); border-radius: 6px; background: transparent; color: var(--jacare-deep); transition: background .15s ease, color .15s ease; }
  .btn-copy:hover { background: var(--jacare); color: var(--paper); }

  .rss-cta { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.4rem; }

  .assinar-foot { display: flex; align-items: center; gap: 1.1rem; margin-top: 3rem; padding-top: 1.6rem; border-top: 1px solid var(--line-strong); }
  .assinar-foot p { font-size: 0.95rem; }
</style>
